# ─── Database ────────────────────────────────────────────
POSTGRES_DB=ubeflix
POSTGRES_USER=ubeflix_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

DB_HOST=localhost
DB_PORT=5433
DB_NAME=ubeflix
DB_USER=ubeflix_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_a_random_string

# ─── Administrador inicial ───────────────────────────────
# Solo se usa si la base de datos no tiene ningún usuario todavía.
# Si lo dejás vacío se genera una contraseña aleatoria y se imprime una vez al arrancar.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ubeflix.local
ADMIN_PASSWORD=

# ─── Backend ─────────────────────────────────────────────
NODE_ENV=production
PORT=5566
VIDEOS_PATH=./videos

# ─── OpenSubtitles ───────────────────────────────────────
# https://www.opensubtitles.com/consumers → crear consumer
OPENSUBTITLES_API_KEY=tu_api_key
OPENSUBTITLES_USER=tu_usuario
OPENSUBTITLES_PASS=tu_password

# ─── Spotify (Music) ─────────────────────────────────────
# https://developer.spotify.com/dashboard → tu app → Settings
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret

# ─── Frontend build arg ─────────────────────────────────
REACT_APP_API_URL=http://localhost:5566/api

# ─── Agente de remontaje (host-agent) ───────────────────
# Reconecta unidades del host desde la app. Ver host-agent/README.md
REMOUNT_AGENT_URL=http://localhost:9797
REMOUNT_AGENT_TOKEN=CHANGE_ME_random_token
